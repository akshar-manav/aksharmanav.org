  <creationDate>2026-08-17</creationDate>
  <author>Akshar Manav website project</author>
  <authorEmail>admin@aksharmanav.org</authorEmail>
  <copyright>Copyright Akshar Manav</copyright>
  <license>GPL-2.0-or-later</license>
  <description>TPL_AKSHARMANAV_XML_DESCRIPTION</description>
  <parent>cassiopeia</parent>
  <files>
    <filename>index.php</filename>
    <filename>templateDetails.xml</filename>
    <folder>css</folder>
    <folder>js</folder>
    <folder>language</folder>
  </files>
  <positions>
    <position>brand</position>
    <position>primary-menu</position>
    <position>language-switcher</position>
    <position>breadcrumbs</position>
    <position>home-identity</position>
    <position>home-featured-event</position>
    <position>home-work-areas</position>
    <position>home-initiatives</position>
    <position>home-thought</position>
    <position>home-publication</position>
