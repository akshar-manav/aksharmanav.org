    <position>before-component</position>
    <position>after-component</position>
    <position>footer-primary</position>
    <position>footer-secondary</position>
    <position>debug</position>
  </positions>
  <languages folder="language">
    <language tag="en-GB">en-GB/tpl_aksharmanav.ini</language>
    <language tag="en-GB">en-GB/tpl_aksharmanav.sys.ini</language>
  </languages>
  <config>
    <fields name="params">
      <fieldset name="advanced">
        <field
          name="contentWidth"
          type="list"
          default="wide"
          label="TPL_AKSHARMANAV_FIELD_CONTENT_WIDTH_LABEL"
          description="TPL_AKSHARMANAV_FIELD_CONTENT_WIDTH_DESC"
        >
          <option value="reading">TPL_AKSHARMANAV_FIELD_CONTENT_WIDTH_READING</option>
          <option value="wide">TPL_AKSHARMANAV_FIELD_CONTENT_WIDTH_WIDE</option>
          <option value="full">TPL_AKSHARMANAV_FIELD_CONTENT_WIDTH_FULL</option>
        </field>
      </fieldset>
    </fields>
  </config>
</extension>
