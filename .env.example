# Copy this file to .env and replace every replace-with-* value before first use.
# .env is intentionally ignored by Git.
COMPOSE_PROJECT_NAME=akshar_manav_local
JOOMLA_HTTP_PORT=8080

JOOMLA_DB_NAME=joomla
JOOMLA_DB_USER=joomla
JOOMLA_DB_PASSWORD=replace-with-a-unique-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-unique-root-password

# Neutral local-only values used by the official image's unattended installer.
JOOMLA_SITE_NAME=Local Joomla
JOOMLA_ADMIN_USER=Local Administrator
JOOMLA_ADMIN_USERNAME=localadmin
JOOMLA_ADMIN_PASSWORD=replace-with-a-unique-admin-password
JOOMLA_ADMIN_EMAIL=admin@example.test
