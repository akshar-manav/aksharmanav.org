{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "instructions": [
    "docs/OPERATING_GUIDE.md",
    "docs/PRODUCT_BRIEF.md",
    "docs/ORGANISATIONAL_TRUTH_REGISTER.md",
    "docs/RELEASE_PROCESS.md"
  ],
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/configuration.php": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git branch --show-current*": "allow",
      "git push*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git checkout -- *": "deny",
      "rm *": "deny",
      "rmdir *": "deny",
      "del *": "deny",
      "Remove-Item *": "deny",
      "format *": "deny",
      "railway *": "deny",
      "vercel *": "deny",
      "wrangler *": "deny"
    },
    "task": "deny",
    "external_directory": "deny",
    "webfetch": "ask",
    "websearch": "ask",
    "doom_loop": "ask",
    "mcp_*": "deny"
  }
}
